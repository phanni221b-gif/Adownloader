<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.adownloader.app.ui.ThumbnailView android:id="@+id/library_thumbnail" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_thumb" android:src="@drawable/ic_media" android:scaleType="centerCrop" android:importantForAccessibility="no" />
        <TextView android:id="@+id/library_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="8dp" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:background="#B3202027" android:textColor="#FFFFFF" android:textSize="12sp" />
    </FrameLayout>
    <TextView android:id="@+id/library_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/ink" android:textSize="14sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/library_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="12dp" android:textAppearance="@style/UiBody" android:maxLines="2" />
</LinearLayout>