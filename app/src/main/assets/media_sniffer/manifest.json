{
  "manifest_version": 2,
  "name": "Adownloader Media Sniffer",
  "version": "1.0.0",
  "description": "Captures media network requests and page media sources for Adownloader.",
  "browser_specific_settings": {
    "gecko": {
      "id": "adownloader-media@local"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["content.js"]
    }
  ],
  "permissions": [
    "<all_urls>",
    "webRequest",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ]
}
