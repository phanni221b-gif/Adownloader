{
  "manifest_version": 2,
  "name": "Adownloader Media Sniffer",
  "version": "2.5.0",
  "description": "Observes media network requests and page media resources for Adownloader.",
  "browser_specific_settings": {
    "gecko": {
      "id": "media-sniffer@adownloader.local"
    }
  },
  "permissions": [
    "<all_urls>",
    "webRequest",
    "nativeMessaging",
    "geckoViewAddons",
    "nativeMessagingFromContent",
    "webRequestBlocking"
  ],
  "background": {
    "scripts": [
      "request_context.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js",
        "manifest_transport.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
